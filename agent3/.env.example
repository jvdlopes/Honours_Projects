# Copy to .env (same folder) and fill in. Use forward slashes in Windows paths.
# Lists are JSON.

# --- LLM ---
# Put the key HERE, not as a system-wide variable (otherwise Claude Code bills
# your Pro usage to the API).
ANTHROPIC_API_KEY=sk-ant-...
AGENT3_LLM_MODEL=anthropic:claude-sonnet-5-5

# --- PowerMCP OpenDSS server ---
# A dedicated PowerMCP environment, separate from Agent 3's (PowerMCP needs mcp>=2,
# langchain-mcp-adapters needs mcp<2). Recommended one-time setup, outside any project:
#   py -m venv "%USERPROFILE%\.venvs\powermcp"
#   "%USERPROFILE%\.venvs\powermcp\Scripts\pip" install "powermcp[opendss]"
AGENT3_MCP_COMMAND=C:/Users/<you>/.venvs/powermcp/Scripts/powermcp.exe
AGENT3_MCP_ARGS=["run","opendss"]
# Alternative: a PowerMCP repo clone, run with that environment's python:
# AGENT3_MCP_COMMAND=C:/path/to/env/Scripts/python.exe
# AGENT3_MCP_ARGS=["C:/path/to/PowerMCP/OpenDSS/opendss_mcp.py"]
# Folders the server may read (your OpenDSS models).
AGENT3_ALLOWED_ROOTS=["C:/Users/Taha Riyaan/Documents/OpenDSS"]

# --- Testing ---
AGENT3_TEST_FEEDER=C:/Users/Taha Riyaan/Documents/OpenDSS/123Bus/IEEE123Master.dss

# --- Optional (defaults shown) ---
# AGENT3_MAX_TOOL_CALLS=40
# AGENT3_MAX_ATTEMPTS=3
# AGENT3_V_MIN_PU=0.95
# AGENT3_V_MAX_PU=1.05
# AGENT3_THERMAL_LIMIT_PCT=100
# AGENT3_FILTER_SERVER_STDOUT=true
